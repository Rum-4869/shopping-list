<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>買い物リスト</title>
  <link rel="stylesheet" href="/styles.css?v=4">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#4f9cff">
  <link rel="icon" type="image/svg+xml" href="/icons/icon.svg">
  <link rel="apple-touch-icon" href="/icons/icon.svg">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap" rel="stylesheet">
  <script>
    try {
      const s = JSON.parse(localStorage.getItem('shopping-settings-v1') || '{}');
      if (s.theme === 'dark') document.documentElement.classList.add('dark-mode');
    } catch(e) {}
  </script>
</head>
<body>
  <div class="container">
    <header class="app-header">
      <div>
        <p class="eyebrow"><%= isShared ? '共有リスト' : '今日の買い物' %></p>
      </div>
    </header>

    <% if (isShared) { %>
      <div class="share-banner">
        <div class="share-banner-content">
          <span class="share-banner-tag">共有中</span>
          <span>合言葉: <strong><%= roomName %></strong></span>
        </div>
        <form action="/share/leave" method="post" style="margin: 0;">
          <button class="share-banner-leave" type="submit" aria-label="個人リストに戻る">解除</button>
        </form>
      </div>
    <% } %>

    <!-- よく買うものクイック追加チップ -->
    <div class="quick-chips-wrapper" id="quick-chips-wrapper">
      <div class="quick-chips-header">
        <span class="quick-chips-title">よく買うもの</span>
        <button id="toggle-edit-presets-btn" class="edit-presets-btn" type="button">編集</button>
      </div>
      <div class="quick-chips-list" id="quick-chips-list">
        <% (presets || []).forEach((p) => { %>
          <div class="chip-wrapper" data-preset-id="<%= p.id %>">
            <button class="chip-btn" type="button" data-item="<%= p.name %>">
              <span><%= p.icon %></span> <%= p.name %>
            </button>
            <button class="chip-delete-btn" type="button" data-preset-id="<%= p.id %>" aria-label="<%= p.name %>を削除">×</button>
          </div>
        <% }) %>
        <button id="add-preset-btn" class="add-preset-chip-btn" type="button">＋ 追加</button>
      </div>
    </div>


    <form class="add-form" action="/add" method="post">
      <input
        type="text"
        name="itemName"
        placeholder="買うものを入力"
        maxlength="30"
        required
        aria-label="買うもの"
      >
      <button type="button" class="mic-btn" id="mic-btn" aria-label="音声入力">
        <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none">
          <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"></path>
          <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
          <line x1="12" y1="19" x2="12" y2="22"></line>
        </svg>
      </button>
      <button class="add-btn" type="submit">追加</button>
    </form>
    <p class="helper-text">1〜30文字で入力できます</p>

    <div class="list-toolbar">
      <span class="badge"><%= items.filter(item => !item.done).length %>件残り</span>
      <div class="toolbar-actions">
        <button id="share-list-btn" class="share-list-btn" type="button" aria-label="リストを送る">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
          </svg>
          <span>送る</span>
        </button>
        <% const completedCount = items.filter(item => item.done).length; %>
        <button id="clear-completed-btn" class="clear-completed-btn <%= completedCount === 0 ? 'hidden' : '' %>" type="button" aria-label="購入済みをまとめて削除">
          <svg class="clear-icon" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
          </svg>
          <span class="clear-text">購入済みを削除 (<span id="completed-count"><%= completedCount %></span>)</span>
        </button>
      </div>
    </div>


    <ul class="item-list">
      <% items.forEach((item, index) => { %>
        <% const itemName = typeof item === 'string' ? item : item.name; %>
        <% const isDone = typeof item === 'string' ? false : item.done; %>
        <li class="shopping-item <%= isDone ? 'done' : '' %> <%= index === items.length - 1 ? 'new-item' : '' %>" data-id="<%= item.id %>" data-name="<%= itemName %>" data-done="<%= isDone %>">
          <form class="toggle-form" action="/toggle/<%= item.id %>" method="post">
            <button class="check-btn" type="submit" aria-label="<%= isDone ? '未完了に戻す' : '完了にする' %>">
              <span class="checkmark"><%= isDone ? '✓' : '' %></span>
            </button>
          </form>

          <span class="item-name"><%= itemName %></span>

          <div class="quantity-controller">
            <button type="button" class="qty-btn qty-minus" data-id="<%= item.id %>" aria-label="減らす">−</button>
            <span class="qty-value" data-id="<%= item.id %>"><%= item.quantity || 1 %></span>
            <button type="button" class="qty-btn qty-plus" data-id="<%= item.id %>" aria-label="増やす">＋</button>
          </div>

          <form class="delete-form" action="/delete/<%= item.id %>" method="post">
            <button class="delete-btn" type="submit">削除</button>
          </form>
        </li>
      <% }) %>
    </ul>
  </div>

  <script src="/sound.js?v=4"></script>
  <script src="/notify.js?v=4"></script>
  <script>
    (() => {
      const THEME_KEY = 'shopping-settings-v1';
      const settings = JSON.parse(localStorage.getItem(THEME_KEY) || '{}');
      const theme = settings.theme === 'dark' ? 'dark' : 'light';
      document.body.classList.toggle('dark-mode', theme === 'dark');

      const input = document.querySelector('input[name="itemName"]');
      const form = document.querySelector('.add-form');
      const list = document.querySelector('.item-list');

      if (!input || !form || !list) return;

      const clearBtn = document.getElementById('clear-completed-btn');
      const completedCountEl = document.getElementById('completed-count');

      const updateBadge = () => {
        const badge = document.querySelector('.badge');
        const items = [...document.querySelectorAll('.shopping-item:not(.removing)')];
        const remaining = items.filter((item) => !item.classList.contains('done')).length;
        const completed = items.filter((item) => item.classList.contains('done')).length;

        if (badge) {
          badge.textContent = `${remaining}件残り`;
        }

        if (clearBtn && completedCountEl) {
          completedCountEl.textContent = completed;
          if (completed > 0) {
            clearBtn.classList.remove('hidden');
          } else {
            clearBtn.classList.add('hidden');
          }
        }
      };

      if (clearBtn) {
        clearBtn.addEventListener('click', async () => {
          const completedItems = [...document.querySelectorAll('.shopping-item.done:not(.removing)')];
          if (completedItems.length === 0) return;

          if (!confirm(`購入済みのアイテム（${completedItems.length}件）をすべて削除しますか？`)) {
            return;
          }

          try {
            const response = await fetch('/clear-completed', {
              method: 'POST',
              headers: {
                'Accept': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
              }
            });

            if (!response.ok) {
              throw new Error('clear-completed failed');
            }

            completedItems.forEach((item) => {
              item.classList.add('removing');
            });

            setTimeout(() => {
              completedItems.forEach((item) => item.remove());
              syncStorage();
              window.AppSound && window.AppSound.play('delete');
            }, 250);
          } catch (error) {
            console.error('一括削除に失敗しました', error);
            alert('削除に失敗しました。ページを再読み込みしてください。');
          }
        });
      }


      const syncStorage = () => {
        updateBadge();
      };

      const sendReorder = async () => {
        const order = [...document.querySelectorAll('.shopping-item')]
          .map((item) => Number(item.dataset.id))
          .filter((id) => Number.isInteger(id));

        if (!order.length) return;

        try {
          await fetch('/reorder', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ order })
          });
          syncStorage();
        } catch (error) {
          console.warn('並び替えの保存に失敗しました', error);
        }
      };

      input.addEventListener('input', () => {
        const remaining = 30 - input.value.length;
        const helper = document.querySelector('.helper-text');
        if (helper) {
          helper.textContent = remaining >= 0 ? `${remaining}文字入力できます` : '30文字以内で入力してください';
        }
      });

      const createItemElement = (item) => {
        const li = document.createElement('li');
        li.className = `shopping-item ${item.done ? 'done' : ''}`;
        li.dataset.id = String(item.id);
        li.dataset.name = item.name;
        li.dataset.done = String(Boolean(item.done));

        li.innerHTML = `
          <form class="toggle-form" action="/toggle/${item.id}" method="post">
            <button class="check-btn" type="submit" aria-label="${item.done ? '未完了に戻す' : '完了にする'}">
              <span class="checkmark">${item.done ? '✓' : ''}</span>
            </button>
          </form>
          <span class="item-name">${item.name}</span>
          <div class="quantity-controller">
            <button type="button" class="qty-btn qty-minus" data-id="${item.id}" aria-label="減らす">−</button>
            <span class="qty-value" data-id="${item.id}">${item.quantity || 1}</span>
            <button type="button" class="qty-btn qty-plus" data-id="${item.id}" aria-label="増やす">＋</button>
          </div>
          <form class="delete-form" action="/delete/${item.id}" method="post">
            <button class="delete-btn" type="submit">削除</button>
          </form>
        `;

        li.draggable = true;
        return li;
      };

      const attachItemEvents = (itemElement) => {
        itemElement.addEventListener('dragstart', (event) => {
          draggedItem = itemElement;
          itemElement.classList.add('dragging');
          event.dataTransfer.effectAllowed = 'move';
          event.dataTransfer.setData('text/plain', itemElement.dataset.id || '');
        });

        itemElement.addEventListener('dragend', () => {
          itemElement.classList.remove('dragging');
          itemElement.classList.remove('drag-over');
          itemElement.classList.remove('drag-over-top');
          itemElement.classList.remove('drag-over-bottom');
          draggedItem = null;
        });

        itemElement.addEventListener('dragover', (event) => {
          event.preventDefault();
          if (!draggedItem || draggedItem === itemElement) return;
          itemElement.classList.add('drag-over');
          const rect = itemElement.getBoundingClientRect();
          const isBelowMidpoint = event.clientY > rect.top + rect.height / 2;
          itemElement.classList.toggle('drag-over-top', !isBelowMidpoint);
          itemElement.classList.toggle('drag-over-bottom', isBelowMidpoint);
        });

        itemElement.addEventListener('dragleave', () => {
          itemElement.classList.remove('drag-over');
          itemElement.classList.remove('drag-over-top');
          itemElement.classList.remove('drag-over-bottom');
        });

        itemElement.addEventListener('drop', (event) => {
          event.preventDefault();
          if (!draggedItem || draggedItem === itemElement) return;

          const rect = itemElement.getBoundingClientRect();
          const insertAfter = event.clientY > rect.top + rect.height / 2;
          const parent = itemElement.parentElement;

          if (insertAfter) {
            parent.insertBefore(draggedItem, itemElement.nextSibling);
          } else {
            parent.insertBefore(draggedItem, itemElement);
          }

          itemElement.classList.remove('drag-over');
          itemElement.classList.remove('drag-over-top');
          itemElement.classList.remove('drag-over-bottom');
          sendReorder();
        });
      };

      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        const itemName = input.value.trim();
        if (!itemName) {
          return;
        }

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
              'Accept': 'application/json',
              'X-Requested-With': 'XMLHttpRequest'
            },
            body: new URLSearchParams({ itemName }).toString()
          });

          if (!response.ok) {
            throw new Error('submit failed');
          }

          const data = await response.json();
          if (!data || !data.ok || !data.item) {
            throw new Error('invalid response');
          }

          const itemElement = createItemElement(data.item);
          attachItemEvents(itemElement);
          list.appendChild(itemElement);
          form.reset();
          syncStorage();
          window.AppSound && window.AppSound.play('add');
          list.scrollTo({ top: list.scrollHeight, behavior: 'smooth' });
        } catch (error) {
          form.submit();
        }
      });

      const addItemDirectly = async (name) => {
        const itemName = String(name || '').trim();
        if (!itemName) return;

        // すでにリストにある場合はスクロールしてハイライト表示
        const existingItem = [...document.querySelectorAll('.shopping-item')].find(
          (el) => (el.dataset.name || '').toLowerCase() === itemName.toLowerCase()
        );

        if (existingItem) {
          existingItem.scrollIntoView({ behavior: 'smooth', block: 'center' });
          existingItem.classList.add('highlight-item');
          setTimeout(() => existingItem.classList.remove('highlight-item'), 1200);
          return;
        }

        try {
          const response = await fetch('/add', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
              'Accept': 'application/json',
              'X-Requested-With': 'XMLHttpRequest'
            },
            body: new URLSearchParams({ itemName }).toString()
          });

          if (!response.ok) {
            throw new Error('quick add failed');
          }

          const data = await response.json();
          if (!data || !data.ok || !data.item) {
            throw new Error('invalid response');
          }

          const itemElement = createItemElement(data.item);
          attachItemEvents(itemElement);
          list.appendChild(itemElement);
          syncStorage();
          window.AppSound && window.AppSound.play('add');
          list.scrollTo({ top: list.scrollHeight, behavior: 'smooth' });
        } catch (error) {
          console.warn('クイック追加に失敗しました', error);
        }
      };

      // プリセット（よく買うもの）の編集モード
      const chipsWrapper = document.getElementById('quick-chips-wrapper');
      const toggleEditPresetsBtn = document.getElementById('toggle-edit-presets-btn');
      const addPresetBtn = document.getElementById('add-preset-btn');
      const chipsList = document.getElementById('quick-chips-list');

      let isEditingPresets = false;

      if (toggleEditPresetsBtn && chipsWrapper) {
        toggleEditPresetsBtn.addEventListener('click', () => {
          isEditingPresets = !isEditingPresets;
          chipsWrapper.classList.toggle('is-editing', isEditingPresets);
          toggleEditPresetsBtn.textContent = isEditingPresets ? '完了' : '編集';
        });
      }

      // プリセット（よく買うもの）の追加
      if (addPresetBtn) {
        addPresetBtn.addEventListener('click', async () => {
          const name = prompt('よく買うものの名前を入力してください（例: 納豆、ヨーグルトなど）:');
          if (!name || !name.trim()) return;

          try {
            const response = await fetch('/presets/add', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                'Accept': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
              },
              body: new URLSearchParams({ name: name.trim() }).toString()
            });

            if (!response.ok) {
              const err = await response.json().catch(() => ({}));
              alert(err.message || '追加に失敗しました');
              return;
            }

            const data = await response.json();
            if (data && data.ok && data.preset) {
              const wrapper = document.createElement('div');
              wrapper.className = 'chip-wrapper';
              wrapper.dataset.presetId = String(data.preset.id);
              wrapper.innerHTML = `
                <button class="chip-btn" type="button" data-item="${data.preset.name}">
                  <span>${data.preset.icon}</span> ${data.preset.name}
                </button>
                <button class="chip-delete-btn" type="button" data-preset-id="${data.preset.id}" aria-label="${data.preset.name}を削除">×</button>
              `;

              chipsList.insertBefore(wrapper, addPresetBtn);
              window.AppSound && window.AppSound.play('add');
            }
          } catch (e) {
            console.error('プリセット追加エラー:', e);
          }
        });
      }

      // チップリスト内のクリックイベント（委任：追加 or 削除）
      if (chipsList) {
        chipsList.addEventListener('click', async (event) => {
          const deleteBtn = event.target.closest('.chip-delete-btn');
          if (deleteBtn) {
            const presetId = deleteBtn.dataset.presetId;
            const chipWrapper = deleteBtn.closest('.chip-wrapper');
            if (!presetId || !chipWrapper) return;

            try {
              const response = await fetch(`/presets/delete/${presetId}`, {
                method: 'POST',
                headers: {
                  'Accept': 'application/json',
                  'X-Requested-With': 'XMLHttpRequest'
                }
              });

              if (response.ok) {
                chipWrapper.remove();
                window.AppSound && window.AppSound.play('delete');
              }
            } catch (e) {
              console.error('プリセット削除エラー:', e);
            }
            return;
          }

          const chipBtn = event.target.closest('.chip-btn');
          if (chipBtn && !isEditingPresets) {
            const item = chipBtn.dataset.item;
            if (item) addItemDirectly(item);
          }
        });
      }

      document.addEventListener('submit', async (event) => {
        const form = event.target;
        if (!(form instanceof HTMLFormElement)) return;

        if (form.classList.contains('toggle-form')) {
          event.preventDefault();
          const id = Number(form.action.split('/').pop());
          const item = document.querySelector(`.shopping-item[data-id="${id}"]`);
          if (!item) return;

          try {
            const response = await fetch(form.action, {
              method: 'POST',
              headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
              body: new URLSearchParams(new FormData(form)).toString()
            });

            if (!response.ok) {
              throw new Error('toggle failed');
            }

            const data = await response.json();
            const done = Boolean(data && data.item && data.item.done);
            item.classList.toggle('done', done);
            const checkBtn = item.querySelector('.check-btn');
            const checkmark = item.querySelector('.checkmark');
            if (checkBtn && checkmark) {
              checkBtn.setAttribute('aria-label', done ? '未完了に戻す' : '完了にする');
              checkmark.textContent = done ? '✓' : '';
            }
            syncStorage();

            const allItems = [...document.querySelectorAll('.shopping-item:not(.removing)')];
            const remaining = allItems.filter((el) => !el.classList.contains('done')).length;

            if (done && remaining === 0 && allItems.length > 0) {
              window.AppSound && window.AppSound.play('all-done');
              window.AppNotify && window.AppNotify.send('🎉 今日の買い物完了！', 'すべてのアイテムを買い終わりました！');
            } else {
              window.AppSound && window.AppSound.play(done ? 'check' : 'uncheck');
            }
          } catch (error) {
            form.submit();
          }
        }

        if (form.classList.contains('delete-form')) {
          event.preventDefault();
          const id = Number(form.action.split('/').pop());
          const item = document.querySelector(`.shopping-item[data-id="${id}"]`);
          if (!item) return;

          try {
            const response = await fetch(form.action, {
              method: 'POST',
              headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
              body: new URLSearchParams(new FormData(form)).toString()
            });

            if (!response.ok) {
              throw new Error('delete failed');
            }

            item.remove();
            syncStorage();
            window.AppSound && window.AppSound.play('delete');
          } catch (error) {
            form.submit();
          }
        }
      });

      document.addEventListener('click', async (event) => {
        const qtyBtn = event.target.closest('.qty-btn');
        if (qtyBtn) {
          const id = qtyBtn.dataset.id;
          const delta = qtyBtn.classList.contains('qty-plus') ? 1 : -1;
          const qtyValueEl = document.querySelector(`.qty-value[data-id="${id}"]`);
          if (!qtyValueEl) return;
          
          let currentVal = parseInt(qtyValueEl.textContent || '1', 10);
          if (currentVal === 1 && delta === -1) return; // 1未満にはならない

          try {
            const response = await fetch(`/update-quantity/${id}`, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'Accept': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
              },
              body: new URLSearchParams({ delta }).toString()
            });

            if (response.ok) {
              const data = await response.json();
              if (data.ok && data.item) {
                qtyValueEl.textContent = data.item.quantity;
                qtyBtn.classList.add('qty-animate');
                setTimeout(() => qtyBtn.classList.remove('qty-animate'), 200);
              }
            }
          } catch (e) {
            console.error('Quantity update failed', e);
          }
        }
      });

      // 音声入力 (Web Speech API)
      const micBtn = document.getElementById('mic-btn');
      if (micBtn && ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window)) {
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        const recognition = new SpeechRecognition();
        recognition.lang = 'ja-JP';
        recognition.interimResults = false;
        recognition.maxAlternatives = 1;

        micBtn.addEventListener('click', () => {
          if (micBtn.classList.contains('recording')) {
            recognition.stop();
            return;
          }
          recognition.start();
        });

        recognition.onstart = () => {
          micBtn.classList.add('recording');
          input.placeholder = 'お話しください...';
        };

        recognition.onend = () => {
          micBtn.classList.remove('recording');
          input.placeholder = '買うものを入力';
        };

        recognition.onresult = async (event) => {
          const transcript = event.results[0][0].transcript;
          // 「牛乳と卵とパン」などを分割
          const words = transcript.split(/と|や|、|。|\s+/).filter(w => w.trim().length > 0);
          
          if (words.length > 0) {
            for (const word of words) {
              await addItemDirectly(word);
            }
          }
        };
      } else if (micBtn) {
        micBtn.style.display = 'none'; // 未対応ブラウザは非表示
      }

      // LINE / メッセージ共有
      const shareListBtn = document.getElementById('share-list-btn');
      if (shareListBtn) {
        shareListBtn.addEventListener('click', async () => {
          const items = [...document.querySelectorAll('.shopping-item:not(.done):not(.removing)')];
          if (items.length === 0) {
            alert('共有する未完了のアイテムがありません。');
            return;
          }

          let text = `🛒 買い物リスト (${items.length}件)\n\n`;
          items.forEach(item => {
            const name = item.dataset.name;
            const qtyEl = item.querySelector('.qty-value');
            const qty = qtyEl ? qtyEl.textContent : '1';
            text += `・${name} × ${qty}\n`;
          });
          text += '\n#買い物リスト';

          if (navigator.share) {
            try {
              await navigator.share({
                title: '買い物リスト',
                text: text,
              });
            } catch (err) {
              console.warn('Share failed:', err);
            }
          } else {
            // Web Share API非対応の場合はLINEのURLスキーム
            const lineUrl = `https://line.me/R/msg/text/?${encodeURIComponent(text)}`;
            window.open(lineUrl, '_blank');
          }
        });
      }

      let draggedItem = null;

      const applyDropPosition = (item, event) => {
        const rect = item.getBoundingClientRect();
        const isBelowMidpoint = event.clientY > rect.top + rect.height / 2;
        item.classList.toggle('drag-over-top', !isBelowMidpoint);
        item.classList.toggle('drag-over-bottom', isBelowMidpoint);
      };

      const items = [...document.querySelectorAll('.shopping-item')];

      items.forEach((item) => {
        item.draggable = true;

        item.addEventListener('dragstart', (event) => {
          draggedItem = item;
          item.classList.add('dragging');
          event.dataTransfer.effectAllowed = 'move';
          event.dataTransfer.setData('text/plain', item.dataset.id || '');
        });

        item.addEventListener('dragend', () => {
          item.classList.remove('dragging');
          item.classList.remove('drag-over');
          item.classList.remove('drag-over-top');
          item.classList.remove('drag-over-bottom');
          draggedItem = null;
        });

        item.addEventListener('dragover', (event) => {
          event.preventDefault();
          if (!draggedItem || draggedItem === item) return;
          item.classList.add('drag-over');
          applyDropPosition(item, event);
        });

        item.addEventListener('dragleave', () => {
          item.classList.remove('drag-over');
          item.classList.remove('drag-over-top');
          item.classList.remove('drag-over-bottom');
        });

        item.addEventListener('drop', (event) => {
          event.preventDefault();
          if (!draggedItem || draggedItem === item) return;

          const rect = item.getBoundingClientRect();
          const insertAfter = event.clientY > rect.top + rect.height / 2;
          const list = item.parentElement;

          if (insertAfter) {
            list.insertBefore(draggedItem, item.nextSibling);
          } else {
            list.insertBefore(draggedItem, item);
          }

          item.classList.remove('drag-over');
          item.classList.remove('drag-over-top');
          item.classList.remove('drag-over-bottom');
          sendReorder();
        });
      });

      syncStorage();
    })();
  </script>

  <nav class="mobile-footer" aria-label="メインナビゲーション">
