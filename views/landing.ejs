<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>買い物リスト</title>
  <link rel="stylesheet" href="/styles.css?v=4">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#4f9cff">
  <link rel="icon" type="image/svg+xml" href="/icons/icon.svg">
  <link rel="apple-touch-icon" href="/icons/icon.svg">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap" rel="stylesheet">
  <script>
    try {
      const s = JSON.parse(localStorage.getItem('shopping-settings-v1') || '{}');
      if (s.theme === 'dark') document.documentElement.classList.add('dark-mode');
    } catch(e) {}
  </script>
</head>
<body class="<%= locals.isDark ? 'dark-mode' : '' %>">
  <div class="landing-page">
    <div class="landing-card">
      <div class="hero-mark">🛒</div>
      <p class="eyebrow">Daily helper</p>
      <h1>買い物リスト</h1>
      <p class="landing-copy">今日買うものを、すぐにメモして忘れないようにしましょう。家族と合言葉でリアルタイム共有も可能です。</p>
      <a class="primary-btn" href="/list">始める</a>
    </div>
  </div>

  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch((err) => {
          console.warn('SW registration failed:', err);
        });
      });
    }
  </script>
</body>
</html>
