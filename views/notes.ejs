<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>メモ</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="container">
    <header class="app-header">
      <div>
        <p class="eyebrow">メモ</p>
        <h1>メモ帳</h1>
      </div>
    </header>

    <div class="mini-panel">
      <p>買い物のメモを残せるスペースです。</p>
      <textarea class="note-box" placeholder="今日は何を買う？"></textarea>
      <div class="panel-actions">
        <button class="secondary-btn" id="save-note-btn" type="button">保存する</button>
        <span id="save-status" class="save-status" aria-live="polite">未保存</span>
      </div>
    </div>
  </div>

  <nav class="mobile-footer" aria-label="メインナビゲーション">
    <a class="nav-btn" href="/list" aria-label="リスト">
      <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M7 5.5h10a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-9a2 2 0 0 1 2-2Z"/>
        <path d="M8 8.5h8M8 12h8M8 15.5h5"/>
      </svg>
    </a>
    <a class="nav-btn active" href="/notes" aria-label="メモ">
      <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M7 4.5h8.5L18 7v11.5A1.5 1.5 0 0 1 16.5 20h-9A1.5 1.5 0 0 1 6 18.5v-12A1.5 1.5 0 0 1 7.5 5H7Z"/>
        <path d="M15.5 4.5V8H18M9 11.5h6M9 15h6"/>
      </svg>
    </a>
    <a class="nav-btn" href="/settings" aria-label="設定">
      <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 3.5v2.2M12 18.3v2.2M4.7 12h2.2M17.1 12h2.2M6.6 6.6l1.6 1.6M15.8 15.8l1.6 1.6M17.4 6.6l-1.6 1.6M8.2 15.8l-1.6 1.6"/>
        <circle cx="12" cy="12" r="3.5"/>
      </svg>
    </a>
  </nav>

  <script>
    (() => {
      const THEME_KEY = 'shopping-settings-v1';
      const settings = JSON.parse(localStorage.getItem(THEME_KEY) || '{}');
      document.body.classList.toggle('dark-mode', settings.theme === 'dark');

      const STORAGE_KEY = 'shopping-note-v1';
      const textarea = document.querySelector('.note-box');
      const saveButton = document.getElementById('save-note-btn');
      const status = document.getElementById('save-status');

      if (!textarea || !saveButton || !status) return;

      textarea.value = localStorage.getItem(STORAGE_KEY) || '';

      const markSaved = () => {
        status.textContent = '保存済み';
        status.classList.add('saved');
      };

      const markUnsaved = () => {
        status.textContent = '未保存';
        status.classList.remove('saved');
      };

      textarea.addEventListener('input', markUnsaved);

      saveButton.addEventListener('click', () => {
        localStorage.setItem(STORAGE_KEY, textarea.value);
        markSaved();
      });

      if (textarea.value.trim()) {
        markSaved();
      }
    })();
  </script>
</body>
</html>
