<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>メモ - 買い物リスト</title>
  <link rel="stylesheet" href="/styles.css">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#4f9cff">
  <link rel="icon" type="image/svg+xml" href="/icons/icon.svg">
  <link rel="apple-touch-icon" href="/icons/icon.svg">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <script>
    try {
      const s = JSON.parse(localStorage.getItem('shopping-settings-v1') || '{}');
      if (s.theme === 'dark') document.documentElement.classList.add('dark-mode');
    } catch(e) {}
  </script>
</head>
<body>
  <div class="container">
    <header class="app-header">
      <div>
        <p class="eyebrow"><%= isShared ? '共有メモ' : 'メモ' %></p>
      </div>
    </header>

    <% if (isShared) { %>
      <div class="share-banner">
        <div class="share-banner-content">
          <span class="share-banner-tag">共有中</span>
          <span>合言葉: <strong><%= roomName %></strong></span>
        </div>
        <form action="/share/leave" method="post" style="margin: 0;">
          <button class="share-banner-leave" type="submit" aria-label="個人リストに戻る">解除</button>
        </form>
      </div>
    <% } %>

    <div class="mini-panel">
      <p>買い物のメモを残せるスペースです（クラウドに自動保存されます）。</p>
      <form id="note-form" action="/notes" method="post">
        <textarea class="note-box" name="content" placeholder="買いたいもののレシピや特売情報などをメモ…"><%= note || '' %></textarea>
        <div class="panel-actions">
          <button class="secondary-btn" id="save-note-btn" type="submit">保存する</button>
          <span id="save-status" class="save-status <%= note ? 'saved' : '' %>" aria-live="polite"><%= note ? '保存済み' : '未保存' %></span>
        </div>
      </form>
    </div>
  </div>

  <nav class="mobile-footer" aria-label="メインナビゲーション">
    <a class="nav-btn" href="/list" aria-label="リスト">
      <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M7 5.5h10a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-9a2 2 0 0 1 2-2Z"/>
        <path d="M8 8.5h8M8 12h8M8 15.5h5"/>
      </svg>
    </a>
    <a class="nav-btn active" href="/notes" aria-label="メモ">
      <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M7 4.5h8.5L18 7v11.5A1.5 1.5 0 0 1 16.5 20h-9A1.5 1.5 0 0 1 6 18.5v-12A1.5 1.5 0 0 1 7.5 5H7Z"/>
        <path d="M15.5 4.5V8H18M9 11.5h6M9 15h6"/>
      </svg>
    </a>
    <a class="nav-btn" href="/settings" aria-label="設定">
      <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 3.5v2.2M12 18.3v2.2M4.7 12h2.2M17.1 12h2.2M6.6 6.6l1.6 1.6M15.8 15.8l1.6 1.6M17.4 6.6l-1.6 1.6M8.2 15.8l-1.6 1.6"/>
        <circle cx="12" cy="12" r="3.5"/>
      </svg>
    </a>
  </nav>

  <script src="/sound.js"></script>
  <script>
    (() => {
      const THEME_KEY = 'shopping-settings-v1';
      const settings = JSON.parse(localStorage.getItem(THEME_KEY) || '{}');
      document.body.classList.toggle('dark-mode', settings.theme === 'dark');

      const textarea = document.querySelector('.note-box');
      const form = document.getElementById('note-form');
      const status = document.getElementById('save-status');

      if (!textarea || !form || !status) return;

      let saveTimeout = null;

      const setStatus = (text, isSaved = false, isSaving = false) => {
        status.textContent = text;
        status.classList.toggle('saved', isSaved);
        status.classList.toggle('saving', isSaving);
      };

      const saveNote = async () => {
        setStatus('保存中...', false, true);
        try {
          const response = await fetch('/notes', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
              'Accept': 'application/json',
              'X-Requested-With': 'XMLHttpRequest'
            },
            body: new URLSearchParams({ content: textarea.value }).toString()
          });

          if (response.ok) {
            setStatus('保存済み ✓', true, false);
            window.AppSound && window.AppSound.play('save');
          } else {
            setStatus('保存失敗', false, false);
          }
        } catch (error) {
          console.warn('メモの保存に失敗しました', error);
          setStatus('保存失敗', false, false);
        }
      };


      textarea.addEventListener('input', () => {
        setStatus('入力中… (未保存)', false, false);
        clearTimeout(saveTimeout);
        // 入力停止から1.2秒後にオートセーブ
        saveTimeout = setTimeout(saveNote, 1200);
      });

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        clearTimeout(saveTimeout);
        saveNote();
      });
    })();

    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch((err) => {
          console.warn('SW registration failed:', err);
        });
      });
    }
  </script>
</body>
</html>
