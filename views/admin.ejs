<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>管理者ダッシュボード - 買い物リスト</title>
  <link rel="stylesheet" href="/styles.css">
  <style>
    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      margin: 0;
      padding: 0;
    }
    .admin-container {
      padding: 30px 20px;
      max-width: 1000px;
      margin: 0 auto;
    }
    .admin-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
    }
    .admin-header h2 {
      margin: 0;
      font-size: 1.8rem;
    }
    .back-btn {
      text-decoration: none;
      color: var(--primary);
      font-weight: 600;
    }
    .user-card {
      background: var(--card-bg);
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 24px;
      box-shadow: var(--card-shadow);
      border: 1px solid var(--line);
    }
    .user-card h3 {
      margin-top: 0;
      font-size: 1.2rem;
      border-bottom: 2px solid var(--primary-soft);
      padding-bottom: 10px;
      margin-bottom: 15px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .item-tag {
      display: inline-block;
      padding: 6px 12px;
      margin: 4px;
      border-radius: 20px;
      font-size: 0.9rem;
      background: var(--bg);
      color: var(--text);
      border: 1px solid var(--line);
    }
    .item-tag.done {
      background: #dcfce7;
      color: #166534;
      border-color: #bbf7d0;
      text-decoration: line-through;
      opacity: 0.8;
    }
    body.dark-mode .item-tag.done {
      background: rgba(22, 101, 52, 0.4);
      color: #86efac;
      border-color: rgba(22, 101, 52, 0.6);
    }
    .room-badge {
      background: var(--primary);
      color: white;
      padding: 4px 8px;
      border-radius: 6px;
      font-size: 0.8rem;
      font-weight: bold;
    }
    .personal-badge {
      background: #64748b;
      color: white;
      padding: 4px 8px;
      border-radius: 6px;
      font-size: 0.8rem;
      font-weight: bold;
    }
    .meta-info {
      margin-left: auto;
      color: var(--muted);
      font-size: 0.85rem;
      font-weight: normal;
    }
    .empty-state {
      color: var(--muted);
      font-size: 0.95rem;
      font-style: italic;
    }
    
    /* オーバーライド: adminページではスクロールを許可し、flexセンタリングを解除 */
    body.admin-page {
      display: block !important;
      height: auto !important;
      min-height: 100vh !important;
      overflow-y: auto !important;
      padding: 0 !important;
      background-color: var(--bg) !important;
    }
    html {
      height: auto !important;
      overflow-y: auto !important;
    }
    
    .stats-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 16px;
      margin-bottom: 30px;
    }
    .stat-card {
      background: var(--card-bg);
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 20px;
      text-align: center;
      box-shadow: var(--card-shadow);
    }
    .stat-card h4 {
      margin: 0 0 8px;
      font-size: 0.9rem;
      color: var(--muted);
    }
    .stat-card p {
      margin: 0;
      font-size: 2.2rem;
      font-weight: 800;
      color: var(--primary);
    }
    
    .user-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 20px;
    }
    
    .admin-item-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .admin-item-list li {
      padding: 8px 0;
      border-bottom: 1px solid var(--line);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .admin-item-list li:last-child {
      border-bottom: none;
    }
    .admin-item-list li.done {
      opacity: 0.6;
    }
    .admin-item-name {
      font-weight: 500;
      font-size: 0.95rem;
      display: flex;
      flex-direction: column;
    }
    .admin-item-name.done {
      text-decoration: line-through;
    }
    .admin-item-meta {
      font-size: 0.75rem;
      color: var(--muted);
      text-align: right;
    }
  </style>
</head>
<body class="light-mode admin-page">
  <script>
    // ダークモードの適用
    const THEME_KEY = 'shopping-settings-v1';
    const settings = JSON.parse(localStorage.getItem(THEME_KEY) || '{}');
    if (settings.theme === 'dark') {
      document.body.classList.add('dark-mode');
    }
  </script>
  
  <div class="admin-container">
    <div class="admin-header">
      <h2>管理者ダッシュボード</h2>
      <a href="/" class="back-btn">トップへ戻る</a>
    </div>
    
    <p style="margin-bottom: 30px; color: var(--muted);">登録されているユーザー（個人）や合言葉（ルーム）と、そのリスト一覧です。</p>
    
    <% 
      let totalPersonal = 0;
      let totalShared = 0;
      let totalItems = 0;
      adminData.forEach(u => {
        if(u.isShared) totalShared++; else totalPersonal++;
        totalItems += u.items.length;
      });
    %>
    
    <div class="stats-row">
      <div class="stat-card">
        <h4>個人のユーザー数</h4>
        <p><%= totalPersonal %></p>
      </div>
      <div class="stat-card">
        <h4>合言葉（ルーム）数</h4>
        <p><%= totalShared %></p>
      </div>
      <div class="stat-card">
        <h4>登録アイテム総数</h4>
        <p><%= totalItems %></p>
      </div>
    </div>

    <% if (adminData.length === 0) { %>
      <div class="user-card" style="text-align: center;">
        <p class="empty-state">まだデータがありません。</p>
      </div>
    <% } %>

    <div class="user-grid">
      <% adminData.forEach(user => { %>
        <div class="user-card">
          <h3>
            <% if (user.isShared) { %>
              <span class="room-badge">合言葉</span> <%= user.userId.replace('room:', '') %>
            <% } else { %>
              <span class="personal-badge">個人</span> <%= user.displayName ? user.displayName : user.userId.substring(0, 8) + '...' %>
            <% } %>
            <span class="meta-info">
              作成: <%= new Date(user.createdAt).toLocaleDateString('ja-JP') %>
            </span>
          </h3>
          
          <div>
            <% if (user.note) { %>
              <div style="background: var(--bg); padding: 10px; border-radius: 8px; margin-bottom: 16px; font-size: 0.9rem; border: 1px dashed var(--primary-soft);">
                <strong style="color: var(--muted); font-size: 0.8rem; display: block; margin-bottom: 4px;">📝 メモ</strong>
                <span style="white-space: pre-wrap;"><%= user.note %></span>
              </div>
            <% } %>

            <% if (user.items.length === 0) { %>
              <p class="empty-state">アイテムなし</p>
            <% } else { %>
              <ul class="admin-item-list">
                <% 
                  const pendingItems = user.items.filter(i => !i.done);
                  const doneItems = user.items.filter(i => i.done);
                  const sortedItems = [...pendingItems, ...doneItems];
                %>
                <% sortedItems.forEach(item => { %>
                  <li class="<%= item.done ? 'done' : '' %>">
                    <div class="admin-item-name <%= item.done ? 'done' : '' %>">
                      <span><%= item.name %></span>
                      <% if (user.isShared && item.addedByName) { %>
                        <small style="font-size: 0.7rem; color: var(--muted); margin-top: 2px;">by <%= item.addedByName %></small>
                      <% } %>
                    </div>
                    <div class="admin-item-meta">
                      <div>x<%= item.quantity %></div>
                      <div><%= item.done ? '完了' : '未完了' %></div>
                    </div>
                  </li>
                <% }) %>
              </ul>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</body>
</html>
